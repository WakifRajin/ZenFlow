rules_version = '2';

// ZenFlow security rules for database "zenflow-db1".
// Deploy: firebase deploy --only firestore:rules
//
// Signed-in users may read/write only their own document and device list.
// Server-only collections (OAuth tokens, reminder queues) are closed to all
// clients; Cloud Functions use the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(d) {
      return !('profile' in d) || d.profile == null || (
        d.profile is map &&
        d.profile.keys().hasOnly(['nickname']) &&
        (!('nickname' in d.profile) ||
          (d.profile.nickname is string && d.profile.nickname.size() <= 24))
      );
    }

    // `google` holds the Google Calendar connection status and is written only
    // by the server. Clients must send it back unchanged (or not at all).
    function googleUnchanged(d) {
      return resource == null
        ? (!('google' in d) || d.google == null)
        : (('google' in d) == ('google' in resource.data)) &&
          (!('google' in d) || d.google == resource.data.google);
    }

    function validDoc(d) {
      // v1 fields (state, dailyStats, clientUpdatedAt) stay writable so a
      // cached v1 page keeps working until reload; drop them once v1 is gone.
      return d.keys().hasOnly(['profile', 'data', 'schemaVersion', 'updatedAt', 'google',
                               'state', 'dailyStats', 'clientUpdatedAt']) &&
        (!('schemaVersion' in d) || d.schemaVersion == 2) &&
        (!('data' in d) || d.data is map) &&
        validProfile(d) &&
        googleUnchanged(d);
    }

    match /zenflow_users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validDoc(request.resource.data);

      // Web push tokens for this user's devices.
      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() < 4096
          && (!('platform' in request.resource.data) || (request.resource.data.platform is string && request.resource.data.platform.size() <= 200));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
